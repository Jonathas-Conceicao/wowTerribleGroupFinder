# RELEASE_NOTES.md is generated by GitHub Actions at release time
# (not committed to the repo).
package-as: TerribleGroupFinder
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - .github
  - .planning
  - CHANGELOG.md
  - CLAUDE.md
  - README.md
  - RELEASE_NOTES.md
  - stylua.toml
  - scripts
  - tools
  - "*.png"
  - "*.org"
  - Media/Source
  - Media/Screenshots
  - "*.ase"
  - dist
  - .release
