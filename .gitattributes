# Line endings are declared explicitly so they never depend on a contributor's
# local core.autocrlf setting (same convention as TerribleBuffTracker).

# Baseline: normalize everything text-like to LF inside the repository.
* text=auto

# Addon source. CRLF in the worktree; stylua.toml matches.
*.lua text eol=crlf
*.xml text eol=crlf
*.toc text eol=crlf

# Windows-only scripts.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Read by the Linux CI runner and the BigWigs packager. LF.
*.yml text eol=lf
.pkgmeta text eol=lf
stylua.toml text eol=lf

# Binary. Never convert.
*.png binary
*.blp binary
*.tga binary
*.ase binary
